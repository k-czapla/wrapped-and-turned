# Backend
PORT=3000
SESSION_SECRET=change-me-in-dev
FRONTEND_URL=http://localhost:4200

# Ravelry OAuth 2.0 app credentials
# Create at: https://www.ravelry.com/pro/developer
RAVELRY_CLIENT_ID=
RAVELRY_CLIENT_SECRET=

# Request permissions (space-separated scopes). For refresh tokens, include offline.
RAVELRY_SCOPES=offline

# Optional: if you deploy behind a public URL
# PUBLIC_BACKEND_URL=http://localhost:3000

# Optional: run without Ravelry creds using mock data
# MOCK_RAVELRY=true
